{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "File Tunnel",
  "type": "object",
  "additionalProperties": false,
  "x-ftnl-table": "file_tunnels",
  "required": [
    "tunnelId",
    "status",
    "desktopCapabilityDigest",
    "expiresAt",
    "maxFiles",
    "maxFileBytes",
    "accept"
  ],
  "properties": {
    "tunnelId": {
      "type": "string",
      "format": "uuid",
      "x-ftnl-column": "tunnel_id",
      "x-ftnl-primary-key": true
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "connected",
        "transferring",
        "complete",
        "cancelled",
        "expired"
      ]
    },
    "pairingCapabilityDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "x-ftnl-column": "pairing_capability_digest"
    },
    "desktopCapabilityDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "x-ftnl-column": "desktop_capability_digest"
    },
    "phoneCapabilityDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "x-ftnl-column": "phone_capability_digest"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "x-ftnl-column": "expires_at"
    },
    "maxFiles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "x-ftnl-column": "max_files"
    },
    "maxFileBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5368709120,
      "x-ftnl-column": "max_file_bytes"
    },
    "accept": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string"
      }
    }
  }
}
